# ── Email credentials ──────────────────────────────────────────────────────────
# Gmail: enable IMAP in Settings > See all settings > Forwarding and POP/IMAP
#        then create an App Password at myaccount.google.com/apppasswords
IMAP_HOST=imap.gmail.com
IMAP_PORT=993
EMAIL_ADDRESS=you@gmail.com
EMAIL_PASSWORD=your-app-password

# Outlook / Hotmail
# IMAP_HOST=outlook.office365.com
# IMAP_PORT=993

# ── Claude API ──────────────────────────────────────────────────────────────────
ANTHROPIC_API_KEY=sk-ant-...

# ── Schedule ────────────────────────────────────────────────────────────────────
# Digest runs at this local time every day (24-hour clock)
DIGEST_HOUR=8
DIGEST_MINUTE=0

# How many hours of email to scan on each run
FETCH_LOOKBACK_HOURS=24

# ── Dashboard ───────────────────────────────────────────────────────────────────
DASHBOARD_PORT=5001

# ── Optional: pin specific newsletter senders ───────────────────────────────────
# Comma-separated list of sender email addresses or domains that are always
# treated as newsletters (in addition to the automatic heuristic detection).
# NEWSLETTER_SENDERS=newsletter@example.com,digest@substack.com

# ── Storage ─────────────────────────────────────────────────────────────────────
DB_PATH=newsletter_summarizer/digests.db
